/target
/chord_model*
.claude
.venv/
dist/.venv/

# Audio - renders and DI exports. Hundreds of MB, generated, not versioned.
# (GitHub rejects files >100 MB, and history would keep them forever.)
*.wav
*.flac
*.mp3

# Training artifacts
*.pth
cache_*/


# ONNX models - training artifacts, downloaded from Hugging Face
*.onnx

# Measurement scratch: probe logs and the ground truth they are read against.
# Regenerated by dist/latency_material.py and dist/latency_ground_truth.py.
/probe*.txt
/onsets.csv
__pycache__/
*.pyc

# Local onset measurements and scratch exports
/dist/crediting_measurements/
/training_summary.json.txt
/:memory:.ses
*.pt

# Optional standalone scripts for historical onset experiments. Regenerate with
# build_train_onset_kaggle.py or build_audit_onset_real_kaggle.py.
/dist/train_onset_kaggle.py
/dist/resume_onset_kaggle.py
/dist/audit_onset_real_kaggle.py
