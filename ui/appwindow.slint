import { Button, Slider, CheckBox, VerticalBox, HorizontalBox, GridBox, ScrollView, LineEdit } from "std-widgets.slint";

import "../src/assets/AppFont.ttf"; 

component NoteBar inherits Rectangle {
    in property <string> label;
    in property <brush> bar_color;
    width: 60px;
    height: 65px;
    background: transparent;

    VerticalLayout {
        alignment: center;
        Text {
            text: root.label;
            font-size: 32px;
            color: root.bar_color;
            horizontal-alignment: center;
        }
    }
}

component ModeButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    
    border-radius: 4px;
    background: selected ? #0055ff : #222;
    border-width: 1px;
    border-color: selected ? #4488ff : #444;
    
    TouchArea { clicked => { root.clicked() } }
    
    Text {
        text: root.text;
        font-size: 12px;
        color: root.selected ? white : #aaa;
        font-weight: root.selected ? 700 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

/// Header of one settings tab. Hand-rolled rather than std-widgets' TabWidget:
/// that one hard-codes left-aligned titles, and the tab it shows lives inside
/// the panel, out of reach of the mode buttons above it.
component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    border-radius: 6px;
    background: root.selected ? #2e2e2e : (touch.has-hover ? #282828 : transparent);
    border-width: 1px;
    border-color: root.selected ? #444 : transparent;

    touch := TouchArea { clicked => { root.clicked() } }

    Text {
        text: root.text;
        font-size: 13px;
        color: root.selected ? white : #999;
        font-weight: root.selected ? 700 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

/// A triangle pointing down. Drawn rather than written: "▾" is not in the
/// bundled font, and what a system font puts there differs per platform.
component Chevron inherits Path {
    in property <brush> tint: #999;
    width: 9px;
    height: 5px;
    viewbox-width: 9;
    viewbox-height: 5;
    fill: root.tint;
    commands: "M 0 0 L 9 0 L 4.5 5 Z";
}

/// Drop-down list, hand-rolled for the same reason as the tab bar. The standard
/// ComboBox shows six rows and scrolls the rest behind a scrollbar too thin to
/// notice, so twelve sound cards look like six; this one puts an arrow under the
/// last row when there is more below.
component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);
    /// Fired as the list is about to open, for whoever wants to refresh it first.
    callback opened();

    property <length> row-h: 28px;
    property <int> max-rows: 6;
    property <bool> overflows: root.model.length > root.max-rows;
    property <length> pad: 4px;

    height: 34px;
    horizontal-stretch: 1;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? #555 : #3a3a3a;
    background: root.enabled ? #2a2a2a : #242424;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: root.current-index >= 0 && root.current-index < root.model.length
                ? root.model[root.current-index] : "";
            color: root.enabled ? #ddd : #666;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        Chevron {
            tint: root.enabled ? #999 : #555;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.opened();
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: min(root.model.length, root.max-rows) * root.row-h + 2 * root.pad
                + (root.overflows ? 14px : 0px);
        close-policy: close-on-click-outside;

        Rectangle {
            background: #2a2a2a;
            border-radius: 6px;
            border-width: 1px;
            border-color: #4a4a4a;

            VerticalLayout {
                padding: root.pad;

                list := ScrollView {
                    // Opens with the current row in view, as the standard widget
                    // does. Scrolling by hand replaces this binding.
                    viewport-y: -max(0, root.current-index - root.max-rows + 1) * root.row-h;

                    VerticalLayout {
                        alignment: start;
                        for value[index] in root.model : Rectangle {
                            height: root.row-h;
                            border-radius: 4px;
                            background: index == root.current-index ? #0055ff
                                : (row-touch.has-hover ? #383838 : transparent);

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: value;
                                    font-size: 13px;
                                    color: index == root.current-index ? white : #ccc;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            row-touch := TouchArea {
                                clicked => {
                                    root.current-index = index;
                                    root.selected(index);
                                    popup.close();
                                }
                            }
                        }
                    }
                }

                // The strip is there whenever the list is long, so the popup does
                // not change height as it scrolls; the arrow inside it appears
                // only while something is still below. A fixed arrow was worse
                // than none: it pointed down at a list already at its end.
                if root.overflows : Rectangle {
                    height: 14px;
                    Chevron {
                        visible: -list.viewport-y + list.visible-height < list.viewport-height - 1px;
                        tint: #888;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}

/// Icon toggle. On = inverted: light plate, dark glyph. Off = outline only.
/// The icons are monochrome black on transparent, so `colorize` recolours them.
component IconToggle inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <bool> dim;          // translucent until pointed at
    /// Light plate + dark glyph when active. Switch off where the icon itself
    /// already carries the state, as pause/play does.
    in property <bool> invert: true;
    callback toggled();

    width: 34px;
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    background: root.active && root.invert ? #e8e8e8 : transparent;
    border-color: root.active && root.invert ? transparent : (touch.has-hover ? #666 : #3a3a3a);
    opacity: root.dim && !root.active && !touch.has-hover ? 0.45 : 1.0;
    animate opacity, background { duration: 120ms; }

    Image {
        source: root.icon;
        colorize: root.active && root.invert ? #101010 : (touch.has-hover ? #ddd : #999);
        width: 62%;
        height: 62%;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

component DebugBar inherits Rectangle {
    in property <float> level;
    in property <color> active_color; 
    // No fixed size: the bar filled 60px inside a 50px box and 48 bars at a
    // fixed 8px came to 478px regardless of how wide the panel actually was.
    // Letting the layout distribute the width keeps it inside the panel.
    min-width: 3px;
    horizontal-stretch: 1;
    background: #111;
    
    Rectangle {
        y: parent.height - self.height;
        height: parent.height * level; 
        background: active_color;      
        width: 100%;
    }
}

export global Tr {
    // Filled once at startup from the i18n module. Fields must match `Strings`
    // in src/i18n.rs.
    in-out property <string> chords: "Chords";
    in-out property <string> intervals: "Intervals";
    in-out property <string> scales: "Scales";
    in-out property <string> arpeggios: "Arpeggios";
    in-out property <string> settings: "Settings";
    in-out property <string> close: "Close";
    in-out property <string> settings_title: "Settings & Calibration";
    in-out property <string> tab_audio: "Audio";
    in-out property <string> tab_practice: "Practice";
    in-out property <string> tab_app: "App";
    in-out property <string> audio_calibration: "Audio Calibration";
    in-out property <string> audio_device: "Input: ";
    in-out property <string> audio_channel: "Channel: ";
    in-out property <string> audio_default: "System default";
    in-out property <string> audio_one: "Channel";
    in-out property <string> noise_gate: "Noise gate: ";
    in-out property <string> gate_hint: "";
    in-out property <string> bass_boost: "Bass Boost";
    in-out property <string> lock_quality: "Lock chord quality until new attack";
    in-out property <string> short_verdict: "Judge short strums on the attack";
    in-out property <string> short_verdict_hint: "";
    in-out property <string> single_notes: "Play the notes one at a time";
    in-out property <string> single_notes_hint: "";
    in-out property <string> random_order: "Random order";
    in-out property <string> shuffle_chords: "Shuffle the chords as well";
    in-out property <string> shuffle_chords_hint: "";
    in-out property <string> show_diagrams: "Show chord shapes";
    in-out property <string> fretboard: "Fretboard";
    in-out property <string> formulas: "Formulas";
    in-out property <string> formula_of: "in";
    in-out property <string> random_hint: "Random order: chords in shuffled order, and in the note modes the tones within each chord too.";
    in-out property <string> startup_mode: "Startup mode: ";
    in-out property <string> chord_confidence: "Chord confidence: ";
    in-out property <string> note_threshold: "Note threshold: ";
    in-out property <string> hold_time: "Hold time: ";
    in-out property <string> show_debug: "Show AI Debug in Main Window";
    in-out property <string> show_spectrum: "Show spectrum";
    in-out property <string> ai_prediction: "AI Prediction:  ";
    in-out property <string> intervals_label: "Intervals: ";
    in-out property <string> intervals_hint: "";
    in-out property <string> intervals_placeholder: "e.g. 1 3 5";
    in-out property <string> next: "Next";
    in-out property <string> previous: "Previous";
    in-out property <string> no_data: "No Data";
    in-out property <string> language: "Language: ";
    in-out property <string> lang_auto: "Auto";
}

export component AppWindow inherits Window {
    title: "Solitito";
    // Window and taskbar icon. Compiled into the binary like the chord shapes,
    // so a release package is still one file with nothing to lose beside it.
    icon: @image-url("../src/assets/app-icon.png");
    /// The size the UI is laid out at, whatever the window size. Resizing sets
    /// the window's scale factor to fit this box, so the UI zooms instead of
    /// reflowing and the proportions are the ones it was designed with. Rust
    /// reads these to compute that factor, so the numbers live only here.
    out property <length> design_w: 550px;
    out property <length> design_h: 800px;

    // preferred-*, not width/height: a fixed width and height makes the window
    // non-resizable.
    preferred-width: root.design_w;
    preferred-height: root.design_h;
    // Always satisfied, because `design` is scaled to fit rather than reflowed:
    // the logical size can never fall below the design size. It is here so the
    // backend derives a physical minimum from the current scale factor, which
    // is what actually stops the window shrinking into unreadability.
    min-width: root.design_w;
    min-height: root.design_h;
    background: #000000;

    /// Emitted when the window changes size, so Rust can recompute the scale
    /// factor. Reading the size back from Rust rather than passing it keeps the
    /// physical/logical distinction in one place.
    callback window_resized();
    changed width => { root.window_resized(); }
    changed height => { root.window_resized(); }
    
    default-font-family: "Noto Sans"; 

    // --- DATA ---
    in property <string> song_title: "";
    in property <string> chord_name: "...";
    // Suggestion only - the model reports pitch classes with no position, so
    // the app cannot verify which string was used. Empty = no hint.
    in property <string> start_hint: "";
    in property <brush> chord_text_color: white;
    
    in property <string> ai_text: "";
    in property <string> next_chord: "";
    /// The chord just left behind, and the colour it earned on the way out -
    /// green for an exact match, yellow for a triad or a substitution, dim for
    /// one merely stepped over. The strip along the bottom shows it: a pass
    /// changes which chord is current, so the only honest place to mark one is
    /// the chord that earned it.
    in property <string> prev_chord: "";
    in property <brush> prev_color: #444;
    /// Stepping through the progression by hand, offered while paused so a
    /// chord that has gone by can be played again. -1 back, +1 forward.
    callback step_chord(int);
    
    // Chord shapes for the current quality, plus the root string each sits on.
    in property <[image]> chord_diagrams;
    in-out property <bool> show_diagrams: true;
    /// Index of the shape shown enlarged, -1 for none.
    in-out property <int> diagram_zoom: -1;

    in property <[string]> interval_names;
    /// Which step is being asked for; the strip scrolls to keep it centred.
    in property <int> interval_step: 0;
    /// Set for the frame the exercise restarts. Walking one step forward wants a
    /// visible glide; snapping back to the first interval of a new key is not a
    /// move through the pattern and must not be animated as one.
    in property <bool> interval_jump: false;
    in property <[color]> interval_colors;
    in property <[float]> spectrum_data;
    in property <[color]> spectrum_colors; 
    
    in property <[string]> library_items;
    in property <string> library_label: "Select Song:"; 
    in-out property <int> current_item_index: 0;

    in property <[string]> secondary_items;
    in property <string> secondary_label: "Key (Root):";
    in-out property <int> current_secondary_index: 0;

    // --- LOGIKA UI ---
    in-out property <int> current_mode: 4;

    // --- FORMULAS MODE ---
    /// Function names of the formula being practised, e.g. ["1","b3","5","b7"].
    in property <[string]> formula_functions;
    /// Which of them have sounded. Parallel to `formula_functions`.
    in property <[bool]> formula_collected;
    /// Note names for the same functions, or empty when the option is off.
    in property <[string]> formula_note_names;
    /// How the root is spelled.
    in property <string> formula_key;
    /// The nearest scale, and what falls outside it.
    in property <string> formula_scale; 
    
    // hidden in the main window by default
    in-out property <bool> ai_debug_visible: false; 
    /// The spectrum in the settings panel. Off by default: it is a calibration
    /// aid, and drawing 48 bars sixty times a second is the most expensive thing
    /// in the panel by a wide margin.
    in-out property <bool> show_spectrum: false;
    callback show_spectrum_changed(bool);

    // --- SETTINGS ---
    in-out property <bool> show_settings: false;
    /// Which settings tab is on screen. On the root so `pick_mode` can send the
    /// user to Practice - picking a mode with the Audio tab open otherwise looks
    /// like nothing happened, the song list being on the tab next door.
    in-out property <int> settings_tab: 0;

    /// Mode buttons go through this rather than calling `mode_changed` directly.
    function pick_mode(m: int) {
        if (root.show_settings) { root.settings_tab = 1; }
        root.mode_changed(m);
    }
    
    // Confidence threshold for the chord NAME (Chords mode).
    in-out property <float> chord_confidence: 0.30;
    // Probability threshold for a SINGLE NOTE (Intervals/Scales/Arpeggios).
    in-out property <float> note_threshold: 0.60;
    in-out property <float> delay: 0.25;
    
    in-out property <bool> boost_enabled: true;
    in-out property <float> boost_gain: 5.0;
    
    in-out property <bool> random_enabled: false;
    /// Whether the shuffle reaches the chord order in Intervals and Arpeggios.
    in-out property <bool> shuffle_chords: false;
    callback shuffle_chords_changed(bool);
    // Icons come from Rust so they can be compiled into the binary alongside the
    // chord shapes rather than shipped as loose files.
    in property <image> icon_shuffle;
    in property <image> icon_gear;
    /// True once any setting differs from what the app started with.
    in property <bool> settings_touched: false;
    in property <image> icon_pause;
    in property <image> icon_play;
    /// Freezes progression: colours still report the chord, the app just stops
    /// moving on. For sitting on one shape and working it out.
    in-out property <bool> paused: false;
    // Holds the recognised quality until the strings are struck again. A seventh
    // decays faster than the rest of the chord, so without this a held Gm7 turns
    // into Gm as it rings out.
    in-out property <bool> lock_quality: true;
    /// Judge a strum on its best reading rather than on how long it is held.
    in-out property <bool> short_verdict: false;
    callback short_verdict_changed(bool);
    /// Note modes: require one note at a time instead of letting a strummed
    /// chord walk its intervals.
    in-out property <bool> single_notes: false;
    callback single_notes_changed(bool);

    // --- AUDIO INPUT ---
    /// What the stream actually opened with, or why it did not. The only
    /// feedback there is on Windows, where the console is hidden.
    in property <string> audio_info: "";
    /// "System default" followed by the devices the host can see.
    in property <[string]> audio_devices;
    in-out property <int> audio_device_index: 0;
    callback audio_device_changed(int);
    /// Asks Rust to look for inputs again, just before the picker is drawn.
    callback audio_devices_rescan();
    /// "Mix all" followed by one entry per channel of the open device.
    in property <[string]> audio_channels;
    in-out property <int> audio_channel_index: 0;
    callback audio_channel_changed(int);
    in property <int> audio_channel_count: 0;
    // Which mode the app opens in (same index as current_mode).
    in-out property <int> startup_mode: 4;
    callback startup_mode_changed(int);
    // 0 = auto (system locale), 1 = Polish, 2 = English
    in-out property <int> language_idx: 0;
    callback language_changed(int);
    in-out property <string> interval_input_text: "1 3 5";

    // --- AUDIO CONTROL ---
    // Gate in dBFS, not linear RMS. A linear 0-0.1 slider could not reach a laptop
    // microphone's noise floor (0.05-0.15 RMS), so the gate was useless exactly
    // where it was needed.
    in-out property <float> gate_db: -34.0;
    // Current input level in dBFS (computed in Rust).
    in-out property <float> input_level_db: -80.0;
    
    callback mode_changed(int); 
    callback item_selected(int);
    callback secondary_item_selected(int); 

    VerticalLayout {
        // Explicit design-sized geometry rather than filling the window. The
        // scale factor already makes this box as large as the window allows;
        // when the window's aspect ratio differs from the design's, the slack
        // is left over on one axis and the box is centred in it. Against a
        // black background that reads as the window simply having margins.
        width: root.design_w;
        height: root.design_h;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        padding: 15px;
        spacing: 15px;

        // TOP BAR
        HorizontalLayout {
            alignment: space-between;
            
            HorizontalLayout {
                spacing: 5px;
                // 350px over five buttons is 65px each - enough for "Interwały"
                // at 12px. At the old 320px the longer labels were clipped.
                // Six buttons now; 420px keeps "Interwały" and "Formuły" whole
                // at 12px, where 350 over six would clip them.
                width: 420px;
                height: 34px;
                ModeButton { text: Tr.fretboard; selected: root.current_mode == 4; width: 16.6%; clicked => { root.pick_mode(4); } }
                ModeButton { text: Tr.chords; selected: root.current_mode == 0; width: 16.6%; clicked => { root.pick_mode(0); } }
                ModeButton { text: Tr.intervals; selected: root.current_mode == 1; width: 16.6%; clicked => { root.pick_mode(1); } }
                ModeButton { text: Tr.scales; selected: root.current_mode == 2; width: 16.6%; clicked => { root.pick_mode(2); } }
                ModeButton { text: Tr.arpeggios; selected: root.current_mode == 3; width: 16.6%; clicked => { root.pick_mode(3); } }
                ModeButton { text: Tr.formulas; selected: root.current_mode == 5; width: 16.6%; clicked => { root.pick_mode(5); } }
            }

            // Same height as the mode row so the three line up on one axis.
            // Hidden in the fretboard trainer, which draws its own region at
            // random and has no order to shuffle.
            IconToggle {
                visible: root.current_mode != 4;
                icon: root.icon_shuffle;
                active: root.random_enabled;
                width: 34px;
                height: 34px;
                toggled => { root.random_enabled = !root.random_enabled; }
            }

            // Icon only, same size as the shuffle toggle. Inverted while the
            // panel is open, which is what the shuffle does for its own state.
            IconToggle {
                icon: root.icon_gear;
                active: root.settings_touched;
                width: 34px;
                height: 34px;
                toggled => { root.show_settings = !root.show_settings; }
            }
        }

        // The settings panel is NOT here. At two thirds of the window it is
        // wider than this 550px box, and a child cannot outgrow its parent,
        // so it is placed by hand below. This holds its space, which is what
        // keeps the top bar from being stretched down into the gap.
        if root.show_settings : Rectangle { }

        // --- MAIN PRACTICE VIEW ---
        if !root.show_settings : VerticalLayout {
            alignment: center;
            spacing: 25px;
            
            Text {
                text: root.song_title;
                font-size: 26px;
                color: #aaa;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: root.chord_name;
                font-size: 60px; 
                font-weight: 400; 
                color: root.chord_text_color; 
                horizontal-alignment: center;
                visible: root.current_mode != 5;
            }

            // FORMULAS. The functions stand on their own line, each lighting up
            // as it sounds - the set may be played in any order, so there is no
            // "current" one to point at.
            if root.current_mode == 5 : VerticalLayout {
                spacing: 14px;

                Text {
                    text: Tr.formula_of + " " + root.formula_key;
                    font-size: 22px;
                    color: #aaa;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    for f[i] in root.formula_functions : Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 8px;
                        border-width: 2px;
                        border-color: root.formula_collected[i] ? #3ecf6a : #3a3a3a;
                        background: root.formula_collected[i] ? #123a20 : #161616;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: f;
                                font-size: 24px;
                                font-weight: root.formula_collected[i] ? 700 : 400;
                                color: root.formula_collected[i] ? #7ef0a0 : #ddd;
                                horizontal-alignment: center;
                            }
                            // Only when the option is on; the functions are the
                            // exercise and the names are a crutch.
                            if root.formula_note_names.length > i : Text {
                                text: root.formula_note_names[i];
                                font-size: 12px;
                                color: #888;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: root.formula_scale;
                    font-size: 15px;
                    color: #777;
                    horizontal-alignment: center;
                }
            }

            // Chords only: the note modes already carry an interval strip here,
            // and two rows of information would fight for the same space.
            if root.current_mode == 0 && root.show_diagrams
               && root.chord_diagrams.length > 0 : HorizontalLayout {
                alignment: center;
                spacing: 12px;
                for i in root.chord_diagrams.length : TouchArea {
                    width: 112px;
                    height: 104px;
                    clicked => { root.diagram_zoom = i; }
                    plate := Rectangle {
                        width: 100%;
                        height: 100%;
                        Image {
                            source: root.chord_diagrams[i];
                            image-fit: contain;
                            width: 100%;
                            height: 100%;
                        }                    }
                }
            }

            if root.start_hint != "" : Text {
                text: root.start_hint;
                // In the fretboard trainer this line IS the exercise - it says
                // where to play. Elsewhere it is a side suggestion, so it stays
                // quiet. Same size as the interval labels the other modes show.
                font-size: root.current_mode == 4 ? 32px : 20px;
                color: root.current_mode == 4 ? #bbb : #888;
                horizontal-alignment: center;
            }
            
            // In the main window only when the checkbox is ticked
            if root.ai_debug_visible : Text {
                text: Tr.ai_prediction + root.ai_text;
                font-size: 24px;
                horizontal-alignment: center;
                color: white; 
            }
            
            // The strip scrolls under a fixed centre rather than the highlight
            // jumping along a static row: a two-octave arpeggio is fifteen steps,
            // about 1050px, and the window is 550px.
            if root.current_mode != 0 : Rectangle {
                height: 65px;
                clip: true;

                property <length> step_w: 70px;   // NoteBar 60px + spacing 10px
                property <int> per_page: 6;       // 6 x 70px = 420px, fits the window
                property <length> content_w: root.interval_names.length * self.step_w;
                // Page, not continuous scroll: the notes stay put while they are
                // being played and the strip turns over once every six.
                property <int> page: floor(root.interval_step / self.per_page);

                HorizontalLayout {
                    spacing: 10px;
                    width: parent.content_w;
                    // Anything up to one page sits centred; longer patterns page.
                    x: parent.content_w <= parent.width
                        ? (parent.width - parent.content_w) / 2
                        : -parent.page * parent.per_page * parent.step_w;
                    // ease-out, not ease-in-out: the slow start of ease-in reads
                    // as lag when the strip turns between two notes being played.
                    animate x {
                        duration: root.interval_jump ? 40ms : 90ms;
                        easing: ease-out;
                    }

                    for i in root.interval_names.length : NoteBar {
                        label: root.interval_names[i];
                        bar_color: root.interval_colors[i];
                    }
                }
            }

            // Last in the column so it sits below whatever the mode shows -
            // under the interval strip in the note modes, under the shapes in
            // Chords, under the position line in the fretboard trainer.
            // The fretboard trainer has nothing to hold: the note is drawn at
            // random and the region already stays put.
            if root.current_mode != 4 : HorizontalLayout {
                alignment: center;
                IconToggle {
                    icon: root.paused ? root.icon_play : root.icon_pause;
                    active: root.paused;
                    dim: true;
                    // The glyph already says which state it is in; inverting the
                    // plate as well made it read like a pressed toggle.
                    invert: false;
                    width: 68px;
                    height: 68px;
                    toggled => { root.paused = !root.paused; }
                }
            }
        }
        
        // STOPKA - poprzedni i nastepny akord
        if !root.show_settings : Rectangle {
            height: 60px;
            // The fretboard trainer has no progression to walk along.
            if root.current_mode != 4 : HorizontalLayout {
                alignment: center;
                spacing: 26px;

                // Only while paused: playing would move the chord on again
                // before the hand got back to the guitar.
                if root.paused : Text {
                    text: "‹";
                    font-size: 34px;
                    color: back_touch.has-hover ? #fff : #ddd;
                    vertical-alignment: center;
                    back_touch := TouchArea { clicked => { root.step_chord(-1); } }
                }

                // Fixed widths, so neither column moves when a name changes
                // length. The chord being asked for is not repeated here - it
                // is already the largest thing on the screen.
                VerticalLayout {
                    width: 150px;
                    Text {
                        text: Tr.previous;
                        font-size: 12px;
                        color: #666;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.prev_chord;
                        // The colour it was passed on, not just "passed": a
                        // chord that only ever went yellow should not be
                        // reported green.
                        color: root.prev_color;
                        font-size: 22px;
                        horizontal-alignment: center;
                    }
                }
                VerticalLayout {
                    width: 150px;
                    Text {
                        text: Tr.next;
                        font-size: 12px;
                        color: #666;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.next_chord;
                        color: white;
                        font-size: 22px;
                        horizontal-alignment: center;
                    }
                }

                if root.paused : Text {
                    text: "›";
                    font-size: 34px;
                    color: fwd_touch.has-hover ? #fff : #ddd;
                    vertical-alignment: center;
                    fwd_touch := TouchArea { clicked => { root.step_chord(1); } }
                }
            }
        }
    }

    // SETTINGS PANEL, placed by hand outside the layout above.
    //
    // Fills the window - keeping the margin it has always had - until the
    // window is half again the minimum width, and then stops. A form gains from
    // width up to a point; past it the rows are just a label at one end of the
    // screen and a control at the other. The practice view is unaffected and
    // keeps its fixed proportions.
    property <length> panel_w: min(root.width, root.design_w * 3 / 2) - 30px;
    /// Width every control in the panel gets: two thirds of it, but never more
    /// than what is left beside the widest label. Without the second half a row
    /// at the minimum window size came to 532px inside 490px of content, and the
    /// whole layout grew wider than the panel - which showed up as the hint text
    /// being cut off on the right, far from where the cause was.
    ///   15px padding on each side, 185px the widest label, 10px the row spacing.
    property <length> ctrl_w: min(root.panel_w * 2 / 3, root.panel_w - 30px - 195px);
    // Aligned to where the top bar ends: box top + padding + bar + spacing.
    property <length> panel_top: (root.height - root.design_h) / 2 + 64px;
    // SETTINGS PANEL
    //
    // Three tabs rather than one long column: the list outgrew the window,
    // and a panel that has to be scrolled hides half of what it offers.
    // Only one tab is on screen at a time, so there is also a third as much
    // to redraw while playing.
    if root.show_settings : Rectangle {
        x: (root.width - self.width) / 2;
        y: root.panel_top;
        width: root.panel_w;
        height: root.design_h - 79px;
        background: #222;
        border-radius: 10px;
        border-width: 1px;
        border-color: #333;

        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 4px;
                height: 32px;
                TabButton { text: Tr.tab_audio; selected: root.settings_tab == 0; clicked => { root.settings_tab = 0; } }
                TabButton { text: Tr.tab_practice; selected: root.settings_tab == 1; clicked => { root.settings_tab = 1; } }
                TabButton { text: Tr.tab_app; selected: root.settings_tab == 2; clicked => { root.settings_tab = 2; } }
            }
            if root.settings_tab == 0 : ScrollView {
                    VerticalLayout {
                        // Rows keep their own height and the slack falls to the
                        // bottom; without this the tab shares its spare height
                        // out among the rows and a one-line combo box ends up
                        // several centimetres tall.
                        alignment: start;
                        padding: 15px;
                        spacing: 18px;

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            spacing: 10px;
                            Text {
                                text: Tr.audio_device; color: #aaa;
                                vertical-alignment: center; width: 100px;
                            }
                            Dropdown {
                                    width: root.ctrl_w;
                                opened => { root.audio_devices_rescan(); }
                                model: root.audio_devices;
                                current-index <=> root.audio_device_index;
                                selected => { root.audio_device_changed(self.current-index); }
                            }
                        }

                        if root.audio_channel_count > 1 : HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: Tr.audio_channel; color: #aaa;
                                vertical-alignment: center; width: 100px;
                            }
                            Dropdown {
                                    width: root.ctrl_w;
                                model: root.audio_channels;
                                current-index <=> root.audio_channel_index;
                                selected => { root.audio_channel_changed(self.current-index); }
                            }
                        }

                        Text {
                            text: root.audio_info;
                            font-size: 11px; color: #777; wrap: word-wrap;
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            // No fixed width: it was set to 130px, then 185px, and
                            // the value still ran off the end under Linux. A label
                            // measured in pixels cannot fit every language on every
                            // platform - the bundled Noto Sans is used only where the
                            // system has none, and fontconfig resolves the name to a
                            // face with different metrics. Sized by its own text, it
                            // fits by construction; the slider takes what is left.
                            Text { text: Tr.noise_gate + round(root.gate_db) + " dB"; color: white; vertical-alignment: center; }
                            Slider { width: root.ctrl_w; horizontal-stretch: 1; minimum: -72.0; maximum: 0.0; step: 0.5; value <=> root.gate_db; }
                        }

                        Rectangle {
                            height: 14px;
                            width: root.ctrl_w;
                            background: #222;
                            border-radius: 3px;
                            Rectangle {
                                x: 0; y: 0; height: parent.height;
                                width: parent.width * Math.max(0.0, Math.min(1.0, (root.input_level_db + 72) / 72));
                                background: root.input_level_db > root.gate_db ? #4a9 : #666;
                                border-radius: 3px;
                            }
                            // threshold marker
                            Rectangle {
                                x: parent.width * Math.max(0.0, Math.min(1.0, (root.gate_db + 72) / 72));
                                y: 0; width: 2px; height: parent.height;
                                background: #e55;
                            }
                        }

                        Text {
                            text: Tr.gate_hint;
                            color: #666; font-size: 11px; wrap: word-wrap;
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            spacing: 10px;
                            HorizontalLayout {
                                // Packed left: with the default stretch the row hands its spare width
                                // to the control, which undoes the width set on it.
                                alignment: start;
                                spacing: 15px;
                                CheckBox { checked <=> root.boost_enabled; }
                                Text { text: Tr.bass_boost; color: #aaa; vertical-alignment: center; }
                            }
                            if root.boost_enabled : Slider {
                                width: root.ctrl_w;
                                minimum: 1.0; maximum: 20.0; value <=> root.boost_gain;
                            }
                        }

                    }
                }
            if root.settings_tab == 1 : ScrollView {
                    VerticalLayout {
                        // Rows keep their own height and the slack falls to the
                        // bottom; without this the tab shares its spare height
                        // out among the rows and a one-line combo box ends up
                        // several centimetres tall.
                        alignment: start;
                        padding: 15px;
                        spacing: 18px;

                        if root.current_mode != 4 : HorizontalLayout {
                            Text { text: root.library_label; color: #aaa; vertical-alignment: center; width: 100px; }
                            Dropdown {
                                    width: root.ctrl_w;
                                model: root.library_items;
                                current-index <=> root.current_item_index;
                                selected => { root.item_selected(self.current-index); }
                            }
                        }

                        if root.current_mode == 2 || root.current_mode == 3 : HorizontalLayout {
                            Text { text: root.secondary_label; color: #aaa; vertical-alignment: center; width: 100px; }
                            Dropdown {
                                    width: root.ctrl_w;
                                model: root.secondary_items;
                                current-index <=> root.current_secondary_index;
                                selected => { root.secondary_item_selected(self.current-index); }
                            }
                        }

                        if root.current_mode == 1 || root.current_mode == 2
                           || root.current_mode == 3 : VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                // Packed left: with the default stretch the row hands its spare width
                                // to the control, which undoes the width set on it.
                                alignment: start;
                                Text { text: Tr.intervals_label; color: #aaa; vertical-alignment: center; width: 80px; }
                                LineEdit {
                                    text <=> root.interval_input_text;
                                    placeholder-text: Tr.intervals_placeholder;
                                }
                            }
                            Text {
                                text: Tr.intervals_hint;
                                // Without this the line runs off to the right rather
                                // than breaking - it fitted before only because the
                                // old hint was short.
                                wrap: word-wrap;
                                color: #666; font-size: 11px;
                            }
                            Rectangle { height: 1px; background: #444; }
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            spacing: 15px;
                            CheckBox { checked <=> root.lock_quality; }
                            Text {
                                text: Tr.lock_quality;
                                color: #aaa; vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                // Packed left: with the default stretch the row hands its spare width
                                // to the control, which undoes the width set on it.
                                alignment: start;
                                spacing: 15px;
                                CheckBox {
                                    checked <=> root.short_verdict;
                                    toggled => { root.short_verdict_changed(self.checked); }
                                }
                                Text {
                                    text: Tr.short_verdict;
                                    color: #aaa; vertical-alignment: center;
                                }
                            }
                            Text {
                                text: Tr.short_verdict_hint;
                                font-size: 12px; color: #777; wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 15px;
                                CheckBox {
                                    checked <=> root.single_notes;
                                    toggled => { root.single_notes_changed(self.checked); }
                                }
                                Text {
                                    text: Tr.single_notes;
                                    color: #aaa; vertical-alignment: center;
                                }
                            }
                            Text {
                                text: Tr.single_notes_hint;
                                font-size: 12px; color: #777; wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                // Packed left: with the default stretch the row hands its spare width
                                // to the control, which undoes the width set on it.
                                alignment: start;
                                spacing: 15px;
                                CheckBox { checked <=> root.random_enabled; }
                                Text {
                                    text: Tr.random_order;
                                    color: #aaa; vertical-alignment: center;
                                }
                            }
                            Text {
                                text: Tr.random_hint;
                                font-size: 12px; color: #777; wrap: word-wrap;
                            }
                        }

                        // Only where the two orders are separable: Intervals and
                        // Arpeggios. In Chords the shuffle has nothing else to
                        // mean, in Scales there is no progression to reorder.
                        //
                        // NOT tied to the shuffle being on. It was, and the
                        // setting vanished the moment the shuffle went off -
                        // which reads as the option disappearing rather than as
                        // it having nothing to do just now.
                        if root.current_mode == 1 || root.current_mode == 3 : VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 15px;
                                CheckBox {
                                    checked <=> root.shuffle_chords;
                                    toggled => { root.shuffle_chords_changed(self.checked); }
                                }
                                Text {
                                    text: Tr.shuffle_chords;
                                    color: #aaa; vertical-alignment: center;
                                }
                            }
                            Text {
                                // Explicit width, unlike its neighbours: inside an
                                // `if` the layout settles the height before the
                                // width, so a wrapped line goes missing and the
                                // block ends up one line short. Told the width, it
                                // can work its own height out.
                                width: root.panel_w - 30px;
                                text: Tr.shuffle_chords_hint;
                                font-size: 12px; color: #777; wrap: word-wrap;
                            }
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            spacing: 15px;
                            CheckBox { checked <=> root.show_diagrams; }
                            Text {
                                text: Tr.show_diagrams;
                                color: #aaa; vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            spacing: 10px;
                            Text {
                                text: Tr.startup_mode; color: #aaa;
                                vertical-alignment: center; width: 140px;
                            }
                            Dropdown {
                                    width: root.ctrl_w;
                                model: [Tr.chords, Tr.intervals, Tr.scales, Tr.arpeggios, Tr.fretboard];
                                current-index <=> root.startup_mode;
                                selected(v) => { root.startup_mode_changed(root.startup_mode); }
                            }
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            Text { text: Tr.chord_confidence + round(root.chord_confidence*100)/100; color: #aaa; vertical-alignment: center; width: 185px; }
                            Slider { width: root.ctrl_w; minimum: 0.05; maximum: 0.95; step: 0.01; value <=> root.chord_confidence; }
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            Text { text: Tr.note_threshold + round(root.note_threshold*100)/100; color: #aaa; vertical-alignment: center; width: 185px; }
                            Slider { width: root.ctrl_w; minimum: 0.05; maximum: 0.95; step: 0.01; value <=> root.note_threshold; }
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            Text { text: Tr.hold_time + round(root.delay*100)/100 + " s"; color: #aaa; vertical-alignment: center; width: 185px; }
                            Slider { width: root.ctrl_w; minimum: 0.05; maximum: 1.5; step: 0.01; value <=> root.delay; }
                        }

                    }
                }
            if root.settings_tab == 2 : ScrollView {
                    VerticalLayout {
                        // Rows keep their own height and the slack falls to the
                        // bottom; without this the tab shares its spare height
                        // out among the rows and a one-line combo box ends up
                        // several centimetres tall.
                        alignment: start;
                        padding: 15px;
                        spacing: 18px;

                        Text {
                            text: Tr.ai_prediction + root.ai_text;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            color: white;
                        }

                        if root.show_spectrum : Rectangle {
                            height: 60px;
                            background: black;
                            border-radius: 4px;
                            HorizontalLayout {
                                // Packed left: with the default stretch the row hands its spare width
                                // to the control, which undoes the width set on it.
                                alignment: start;
                                padding: 2px;
                                spacing: 1px;
                                for val[i] in root.spectrum_data : DebugBar {
                                    level: val;
                                    active_color: root.spectrum_colors[i];
                                }
                            }
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            spacing: 15px;
                            CheckBox { checked <=> root.ai_debug_visible; }
                            Text { text: Tr.show_debug; color: #aaa; vertical-alignment: center; }
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            spacing: 15px;
                            CheckBox {
                                checked <=> root.show_spectrum;
                                toggled => { root.show_spectrum_changed(self.checked); }
                            }
                            Text { text: Tr.show_spectrum; color: #aaa; vertical-alignment: center; }
                        }

                        HorizontalLayout {
                            // Packed left: with the default stretch the row hands its spare width
                            // to the control, which undoes the width set on it.
                            alignment: start;
                            spacing: 10px;
                            Text {
                                text: Tr.language; color: #aaa;
                                vertical-alignment: center; width: 140px;
                            }
                            Dropdown {
                                    width: root.ctrl_w;
                                model: [Tr.lang_auto, "Polski", "English"];
                                current-index <=> root.language_idx;
                                selected(v) => { root.language_changed(root.language_idx); }
                            }
                        }

                    }
                }
        }
    }

    // Enlarged shape. Last sibling in the root, so it draws over everything.
    // Clicking anywhere dismisses it - a shape is glanced at, not operated.
    if root.diagram_zoom >= 0 && root.diagram_zoom < root.chord_diagrams.length : Rectangle {
        // Explicit full-window size: this sits outside any layout, so without it
        // the overlay would shrink to its content and stop being centred.
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000e0;
        // Without the focus the FocusScope never sees a key press.
        init => { zoom_keys.focus(); }

        // Escape as well as a click - a shape is glanced at, not operated.
        zoom_keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.diagram_zoom = -1;
                    return accept;
                }
                reject
            }
        }

        // Covers the window so a click anywhere dismisses the shape.
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.diagram_zoom = -1; }
        }

        // Placed by hand rather than through a layout: a VerticalLayout centres
        // vertically only, so the shape sat left-aligned.
        Rectangle {
            width: min(parent.width * 0.86, parent.height * 0.62 * 429.10953 / 400);
            height: self.width * 400 / 429.10953;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            Image {
                source: root.chord_diagrams[root.diagram_zoom];
                image-fit: contain;
                width: 100%;
                height: 100%;
            }
        }
    }

}
