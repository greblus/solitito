import { Button, Slider, CheckBox, VerticalBox, HorizontalBox, GridBox, ScrollView, LineEdit } from "std-widgets.slint";

import "../src/assets/AppFont.ttf"; 
import "../src/assets/Accidentals.ttf";

component NoteBar inherits Rectangle {
    in property <string> label;
    in property <brush> bar_color;
    width: 60px;
    height: 65px;
    background: transparent;

    VerticalLayout {
        alignment: center;
        Text {
            text: root.label;
            font-size: 32px;
            color: root.bar_color;
            horizontal-alignment: center;
        }
    }
}

/// One chord of the progression strip. `fg` is the colour it is written in:
/// for one already played, the colour it was passed on.
export struct Chip {
    name: string,
    current: bool,
    played: bool,
    fg: color,
}

/// One degree of the chord in Intervals: its function, the note it is on this
/// chord, and where it stands - 0 later in the order, 1 asked for now, 2 open
/// (free order), 3 being held long enough to count, 4 credited.
export struct IntervalTile {
    degree: string,
    note: string,
    state: int,
}

/// A degree of the chord as a tile: the function large, the note under it,
/// and a badge saying where it stands.
component IntervalCard inherits Rectangle {
    in property <IntervalTile> tile;
    property <bool> done: root.tile.state == 4;
    property <bool> now: root.tile.state == 1 || root.tile.state == 3;
    property <bool> open: root.tile.state == 2;

    border-radius: 16px;
    background: root.done ? #17271F : (root.now ? #1A2640 : #161A22);
    border-width: root.now ? 2px : 1px;
    border-color: root.done ? #24563A : (root.now ? #2F6FE0 : (root.open ? #2D3B5C : #222835));
    animate background, border-color { duration: 150ms; }

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: root.tile.degree;
            font-size: 40px;
            font-weight: 800;
            horizontal-alignment: center;
            color: root.done ? #6EE7A0
                : root.tile.state == 3 ? #D4F27A
                : (root.now || root.open) ? #FFFFFF : #6B7385;
        }
        Text {
            text: root.tile.note;
            font-size: 16px;
            horizontal-alignment: center;
            color: #C9CEDA;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                border-radius: 10px;
                background: root.done ? #1E3A2C : (root.now ? #2F6FE0 : #1C212C);
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    Text {
                        text: root.done ? Tr.tile_done : root.now ? Tr.tile_now
                            : root.open ? Tr.tile_open : Tr.tile_next;
                        font-size: 11px;
                        vertical-alignment: center;
                        color: root.done ? #6EE7A0 : (root.now ? #FFFFFF : #8A92A3);
                    }
                }
            }
        }
    }
}

/// A step through the progression beside the pause: as large a target as
/// the pause itself, the arrow only drawn while it does something.
component StepArrow inherits Rectangle {
    in property <string> glyph;
    in property <bool> shown;
    callback clicked();
    width: 68px;
    height: 68px;
    border-radius: 12px;
    background: root.shown && touch.has-hover ? #1C212C : transparent;
    touch := TouchArea {
        enabled: root.shown;
        clicked => { root.clicked(); }
    }
    if root.shown : Text {
        text: root.glyph;
        font-size: 40px;
        color: touch.has-hover ? #FFFFFF : #A9B0C0;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// One chord of the progression strip.
component ProgressChip inherits Rectangle {
    in property <Chip> chip;
    border-radius: 10px;
    background: root.chip.current ? #2F6FE0 : (root.chip.played ? #17271F : #1C212C);
    border-width: root.chip.current ? 2px : 0px;
    border-color: #5A8EF0;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.chip.name;
            font-size: 15px;
            font-weight: root.chip.current ? 700 : 500;
            color: root.chip.current ? #FFFFFF : root.chip.fg;
            vertical-alignment: center;
        }
    }
}

/// A note the model hears, and whether the chord asked for has it.
export struct HeardNote {
    name: string,
    in_chord: bool,
}

/// The arrow on anything that opens downwards: the side navigation's folding
/// entries and the drop-down lists. One shape for both, so it reads as one
/// gesture wherever it appears.
component FoldArrow inherits Path {
    in property <bool> up;
    in property <brush> tint: #A9B0C0;
    width: 14px;
    height: 14px;
    viewbox-width: 14;
    viewbox-height: 14;
    commands: root.up ? "M 2 9.5 L 7 4.5 L 12 9.5" : "M 2 4.5 L 7 9.5 L 12 4.5";
    stroke: root.tint;
    stroke-width: 1.8px;
    fill: transparent;
}

/// A quick option of the mode on screen, unfolded under its entry in the
/// side navigation: the label lined up with the entries' labels, a switch
/// at the end, the whole row clickable.
component SideToggle inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback toggled();

    height: 32px;
    border-radius: 8px;
    background: touch.has-hover ? #1C212C : transparent;
    touch := TouchArea { clicked => { root.toggled(); } }
    HorizontalLayout {
        padding-left: 44px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.text;
            font-size: 13px;
            color: root.on ? #E8EAF0 : #A9B0C0;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 18px;
                border-radius: 9px;
                background: root.on ? #2F6FE0 : #2A3142;
                animate background { duration: 120ms; }
                Rectangle {
                    x: root.on ? 16px : 2px;
                    y: 2px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: root.on ? #FFFFFF : #6B7385;
                    animate x { duration: 120ms; }
                }
            }
        }
    }
}

/// One entry of the side navigation: an icon and a label, the whole row
/// clickable. The icon is either a stroke path in a 20x20 box or an image.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> path;
    in property <image> image;
    in property <bool> selected;
    /// A small dot at the end of the row: the panel holds unsaved changes.
    in property <bool> marked;
    /// The mode on screen, when it has quick options to unfold under it: a
    /// click on it then folds them in or out, and the arrow says which.
    in property <bool> expandable;
    in property <bool> expanded;
    callback clicked;

    height: 40px;
    border-radius: 10px;
    background: root.selected ? #243049 : (touch.has-hover ? #1C212C : transparent);
    animate background { duration: 120ms; }

    touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            width: 20px;
            if root.path != "" : Path {
                width: 20px;
                height: 20px;
                viewbox-width: 20;
                viewbox-height: 20;
                commands: root.path;
                stroke: root.selected ? #FFFFFF : #A9B0C0;
                stroke-width: 1.6px;
                fill: transparent;
            }
            if root.path == "" : Image {
                width: 20px;
                height: 20px;
                source: root.image;
                colorize: root.selected ? #FFFFFF : #A9B0C0;
            }
        }
        Text {
            text: root.text;
            font-size: 14px;
            color: root.selected ? #FFFFFF : #A9B0C0;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // Points the way a click would go: down to unfold, up to fold.
        if root.expandable : VerticalLayout {
            alignment: center;
            FoldArrow { up: root.expanded; tint: root.selected ? #FFFFFF : #A9B0C0; }
        }
        if root.marked : VerticalLayout {
            alignment: center;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #F2B233; }
        }
    }
}

/// Header of one settings tab. Hand-rolled rather than std-widgets' TabWidget:
/// that one hard-codes left-aligned titles, and the tab it shows lives inside
/// the panel, out of reach of the mode buttons above it.
/// The input level against the silence threshold, on the gate slider's
/// scale (-72 to 0 dB): blue above the threshold, grey below it, and the
/// threshold itself a yellow line.
component LevelMeter inherits Rectangle {
    in property <float> level_db;
    in property <float> gate_db;

    background: #11141A;
    border-radius: 4px;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * Math.max(0.0, Math.min(1.0, (root.level_db + 72) / 72));
        background: root.level_db > root.gate_db ? #4A90E2 : #2A3142;
        border-radius: 4px;
    }
    Rectangle {
        x: parent.width * Math.max(0.0, Math.min(1.0, (root.gate_db + 72) / 72)) - 1px;
        width: 2px;
        background: #F2B233;
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    border-radius: 8px;
    background: root.selected ? #243049 : (touch.has-hover ? #1C212C : transparent);

    touch := TouchArea { clicked => { root.clicked() } }

    Text {
        text: root.text;
        font-size: 13px;
        color: root.selected ? white : #A9B0C0;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

/// A triangle pointing down. Drawn rather than written: "▾" is not in the
/// bundled font, and what a system font puts there differs per platform.
component Chevron inherits Path {
    in property <brush> tint: #999;
    width: 9px;
    height: 5px;
    viewbox-width: 9;
    viewbox-height: 5;
    fill: root.tint;
    commands: "M 0 0 L 9 0 L 4.5 5 Z";
}

/// One chord shape. Its own component because the shapes are drawn in two rows
/// once there are more than four of them, and a thumbnail repeated by hand in
/// both would drift apart at the first change.
component ShapeThumb inherits TouchArea {
    in property <image> shape;
    in property <length> dw;

    width: root.dw;
    height: root.dw * 104 / 112;

    // A card: the drawing's own background is the card colour, so the
    // rounded corners and the border are all there is to add.
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        border-width: 1px;
        border-color: #222835;
        clip: true;
        Image {
            source: root.shape;
            image-fit: contain;
            width: 100%;
            height: 100%;
        }
    }
}

/// Drop-down list, hand-rolled for the same reason as the tab bar. The standard
/// ComboBox shows six rows and scrolls the rest behind a scrollbar too thin to
/// notice, so twelve sound cards look like six; this one puts an arrow under the
/// last row when there is more below.
component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    /// Puts a cross on every row. For lists that are a collection rather than a
    /// set of choices - throwing one out belongs where it is being looked at.
    in property <bool> deletable: false;
    callback selected(int);
    callback deleted(int);
    /// Fired as the list is about to open, for whoever wants to refresh it first.
    callback opened();
    /// A heading that opens a list rather than a box: no frame, the text as
    /// large as asked, centred, and the list wider than the text it hangs from.
    in property <bool> title-look: false;
    in property <string> title-text;
    in property <length> title-size: 26px;

    property <length> row-h: root.title-look ? 32px : 28px;
    property <int> max-rows: root.title-look ? 10 : 6;
    property <bool> overflows: root.model.length > root.max-rows;
    property <length> pad: 4px;

    height: root.title-look ? root.title-size * 1.5 : 34px;
    horizontal-stretch: 1;
    border-radius: root.title-look ? 10px : 8px;
    border-width: root.title-look ? 0px : 1px;
    border-color: touch.has-hover && root.enabled ? #3A4356 : #2D3444;
    background: root.title-look
        ? (touch.has-hover ? #1C212C : transparent)
        : (root.enabled ? #1C212C : #161A22);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: root.title-look ? center : stretch;

        Text {
            horizontal-stretch: root.title-look ? 0 : 1;
            text: root.title-look ? root.title-text
                : root.current-index >= 0 && root.current-index < root.model.length
                    ? root.model[root.current-index] : "";
            color: root.title-look ? #C9CEDA : (root.enabled ? #E8EAF0 : #6B7385);
            font-size: root.title-look ? root.title-size : 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            FoldArrow { tint: root.enabled ? #A9B0C0 : #555; }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.opened();
            popup.show();
        }
    }

    popup := PopupWindow {
        width: root.title-look ? max(root.width * 0.7, 300px) : root.width;
        x: (root.width - self.width) / 2;
        y: root.title-look ? root.height : 0;
        height: min(root.model.length, root.max-rows) * root.row-h + 2 * root.pad
                + (root.overflows ? 14px : 0px);
        close-policy: close-on-click-outside;

        Rectangle {
            background: #1C212C;
            border-radius: 10px;
            border-width: 1px;
            border-color: #2D3444;

            VerticalLayout {
                padding: root.pad;

                list := ScrollView {
                    // Opens with the current row in view, as the standard widget
                    // does. Scrolling by hand replaces this binding.
                    content-y: -max(0, root.current-index - root.max-rows + 1) * root.row-h;

                    VerticalLayout {
                        alignment: start;
                        for value[index] in root.model : Rectangle {
                            height: root.row-h;
                            border-radius: 6px;
                            background: index == root.current-index ? #2F6FE0
                                : (row-touch.has-hover ? #243049 : transparent);

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: root.deletable ? root.row-h : 8px;
                                Text {
                                    text: value;
                                    font-size: root.title-look ? 15px : 13px;
                                    color: index == root.current-index ? white : #C9CEDA;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            row-touch := TouchArea {
                                clicked => {
                                    root.current-index = index;
                                    root.selected(index);
                                    popup.close();
                                }
                            }

                            // After the row's own touch area, so it is the one
                            // on top: declared inside the layout above it would
                            // be covered by it and never see a click.
                            if root.deletable : Rectangle {
                                width: root.row-h;
                                height: root.row-h;
                                x: parent.width - self.width;
                                Text {
                                    text: "✕";
                                    font-size: 12px;
                                    color: del-touch.has-hover ? #ff7b7b : #888;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                del-touch := TouchArea {
                                    clicked => {
                                        root.deleted(index);
                                        popup.close();
                                    }
                                }
                            }
                        }
                    }
                }

                // The strip is there whenever the list is long, so the popup does
                // not change height as it scrolls; the arrow inside it appears
                // only while something is still below. A fixed arrow was worse
                // than none: it pointed down at a list already at its end.
                if root.overflows : Rectangle {
                    height: 14px;
                    Chevron {
                        visible: -list.content-y + list.visible-height < list.content-height - 1px;
                        tint: #888;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}

/// Icon toggle. On = inverted: light plate, dark glyph. Off = outline only.
/// The icons are monochrome black on transparent, so `colorize` recolours them.
component IconToggle inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <bool> dim;          // translucent until pointed at
    /// Light plate + dark glyph when active. Switch off where the icon itself
    /// already carries the state, as pause/play does.
    in property <bool> invert: true;
    /// For whoever wants to say what the icon does while it is pointed at.
    out property <bool> hovered: touch.has-hover;
    callback toggled();

    width: 34px;
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    background: root.active && root.invert ? #e8e8e8 : transparent;
    border-color: root.active && root.invert ? transparent : (touch.has-hover ? #666 : #3a3a3a);
    opacity: root.dim && !root.active && !touch.has-hover ? 0.45 : 1.0;
    animate opacity, background { duration: 120ms; }

    Image {
        source: root.icon;
        colorize: root.active && root.invert ? #101010 : (touch.has-hover ? #ddd : #999);
        width: 62%;
        height: 62%;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

component DebugBar inherits Rectangle {
    in property <float> level;
    in property <color> active_color; 
    // No fixed size: the bar filled 60px inside a 50px box and 48 bars at a
    // fixed 8px came to 478px regardless of how wide the panel actually was.
    // Letting the layout distribute the width keeps it inside the panel.
    min-width: 3px;
    horizontal-stretch: 1;
    background: #111;
    
    Rectangle {
        y: parent.height - self.height;
        height: parent.height * level; 
        background: active_color;      
        width: 100%;
    }
}

